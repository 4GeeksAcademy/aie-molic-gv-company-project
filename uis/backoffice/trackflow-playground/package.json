{
  "name": "trackflow-operations-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run css && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify -c ./tailwind.config.js",
    "typecheck:utils": "npm --prefix ../../../packages/trackflow-utils run typecheck",
    "test:utils": "npm --prefix ../../../packages/trackflow-utils test"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "vite": "6.4.6"
  }
}
